 "defect": {
  "summary": "resolveSignals labels two different quantities metric 'interval': the whole interval in a pacing-bound window, and interval - cpu in a cpu-bound (or proxy gpu-bound) window. A GPU-work step taken in the first and judged in the second passes the same-metric check and reads as an improvement that did not happen, so the step is kept and never latched.",
  "onDevice": "In all seven traces every GPU-work step was taken in a frame-pacing window and the next window was cpu-work.",
  "nodeReproduction": {
   "config": "tier 0 (low + performance)",
   "signals": {
    "pacing": {
     "gpuP95Ms": null,
     "cpuP95Ms": 14,
     "intervalP95Ms": 23
    },
    "cpuBound": {
     "gpuP95Ms": null,
     "cpuP95Ms": 16,
     "intervalP95Ms": 23
    }
   },
   "trace": [
    {
     "window": "pacing",
     "mode": "frame-pacing",
     "gpuL": 0,
     "latched": false,
     "probe": null
    },
    {
     "window": "pacing",
     "mode": "frame-pacing",
     "gpuL": 1,
     "latched": false,
     "probe": {
      "preStepGpuP95Ms": 23,
      "preStepLevel": 0,
      "metric": "interval"
     }
    },
    {
     "window": "cpuBound",
     "mode": "cpu-work",
     "gpuL": 1,
     "latched": false,
     "probe": null
    },
    {
     "window": "cpuBound",
     "mode": "cpu-work",
     "gpuL": 1,
     "cpuL": 1,
     "latched": false,
     "probe": null
    }
   ],
   "readsAs": "(23 - 7) / 23 = 70% improvement; the interval was 23 ms in every window",
   "regressionTest": "tests/render.webgpu-governor.test.ts on the P9 branch (efc7ca0): it.fails 'KNOWN DEFECT: undoes a pacing-bound GPU step that is judged in a cpu-bound window'"
  },
  "whyTheTestsMissedIt": "Every P9 test fed one constant signal per trace, so the judging window was never of a different class from the stepping window.",
  "strongerDeviceRule": "On the fixed arm, every GPU-work step must be followed by an undo."
 }
