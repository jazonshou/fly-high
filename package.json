{
  "name": "fly-high",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:sim": "vitest run --config tests/sim.vitest.config.ts",
    "test:world": "vitest run --config tests/world.vitest.config.ts",
    "test:gpu": "vitest run --config vitest.gpu.config.ts",
    "typecheck": "tsc --noEmit",
    "benchmark": "vitest run --config vitest.config.ts tests/sim.flight.test.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "lint": "eslint .",
    "perf:cold-start": "vitest run --config vitest.perf.config.ts tests/perf/cold-start.test.ts",
    "perf:capture": "npm run perf:cold-start && vitest run --config vitest.perf.config.ts tests/perf/perf-capture.test.ts",
    "perf:capture:candidate": "npm run perf:cold-start && VITE_PERF_REBASELINE=1 vitest run --config vitest.perf.config.ts tests/perf/perf-capture.test.ts",
    "perf:capture:rebaseline": "npm run perf:capture:candidate",
    "perf:ab": "node scripts/perf-ab.mts",
    "perf:flight": "node scripts/perf-flight.mts",
    "material:preview": "VITE_MATERIAL_PREVIEW=1 vitest run --config vitest.config.ts tests/render.webgpu-material-arrays.test.ts"
  },
  "dependencies": {
    "@babylonjs/core": "9.21.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/browser-playwright": "^4.1.10",
    "@webgpu/types": "^0.1.71",
    "eslint": "9.39.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "meshoptimizer": "1.0.1",
    "playwright": "^1.62.1",
    "sharp": "0.34.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13",
    "vitest": "^4.1.10"
  },
  "type": "module"
}
