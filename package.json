{
  "name": "fly-high",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:pages": "vite build --config vite.static.config.ts",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "vitest run --config vitest.config.ts",
    "test:sim": "vitest run --config tests/sim.vitest.config.ts",
    "test:world": "vitest run --config tests/world.vitest.config.ts",
    "test:gpu": "vitest run --config vitest.gpu.config.ts",
    "typecheck": "tsc --noEmit",
    "benchmark": "vitest run --config vitest.config.ts tests/sim.flight.test.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-pages --ignore-pattern .next",
    "perf:capture": "vitest run --config vitest.perf.config.ts",
    "perf:capture:ci": "VITE_PERF_SHOTS=reference-viewport,forest-500ft-sunbehind,ground-2m-lowsun,motion-banked-turn,cdlod-transition vitest run --config vitest.perf.config.ts",
    "perf:capture:candidate": "VITE_PERF_REBASELINE=1 vitest run --config vitest.perf.config.ts",
    "perf:capture:rebaseline": "npm run perf:capture:candidate",
    "material:preview": "VITE_MATERIAL_PREVIEW=1 vitest run --config vitest.config.ts tests/render.webgpu-material-arrays.test.ts"
  },
  "dependencies": {
    "@babylonjs/core": "9.21.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@vitest/browser-playwright": "^4.1.10",
    "@webgpu/types": "^0.1.71",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.62.1",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
